<!-- Halo detrás de Salve: brillo azul difuso y dos anillos finos, como en el diseño de referencia. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="170dp"
                android:startColor="#552A6FB0" android:centerColor="#1F1E4E80" android:endColor="#00102033" />
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#552F6FA3" />
        </shape>
    </item>
    <item android:left="58dp" android:top="58dp" android:right="58dp" android:bottom="58dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#332F6FA3" />
        </shape>
    </item>
</layer-list>
