<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo exterior suave: la burbuja de Bryan brilla un poco, como en el diseño. -->
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="10dp"
                android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
            <stroke android:width="3dp" android:color="#2659C8F0" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="0" android:startColor="#2E8CC7" android:endColor="#1F689D" />
            <corners android:topLeftRadius="23dp" android:topRightRadius="9dp"
                android:bottomLeftRadius="23dp" android:bottomRightRadius="23dp" />
            <stroke android:width="1.5dp" android:color="#86DDFF" />
        </shape>
    </item>
</layer-list>
