<resources>
    <style name="Theme.Salve.Stage" parent="Theme.Salve">
        <item name="android:windowBackground">@drawable/salve_stage_background</item>
        <item name="android:statusBarColor">#0B1424</item>
        <item name="android:navigationBarColor">#101C2B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">#ACDDD3</item>
        <item name="colorOnPrimary">#102C2A</item>
    </style>
    <style name="SalveStageAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">#E5EFEE</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <!-- Chip con borde: MaterialButton ignora android:background, así que se usan stroke/backgroundTint. -->
    <style name="SalveChatChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#E6F4F6</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">#0F1F2E</item>
        <item name="strokeColor">#46B6C9</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="rippleColor">#3346B6C9</item>
    </style>
    <!-- Botón redondo de enviar con flecha, color menta del diseño. -->
    <style name="SalveSendButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="backgroundTint">#7FE3D2</item>
        <item name="cornerRadius">29dp</item>
        <item name="icon">@drawable/ic_salve_send</item>
        <item name="iconTint">#0E2A2C</item>
        <item name="iconSize">26dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="elevation">6dp</item>
    </style>
    <!-- Tarjetas «Conversar por voz» y «Documentos»: icono en círculo, título y subtítulo. -->
    <style name="SalveActionCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">74dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/salve_action_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="SalveActionCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F0F7F9</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="SalveActionCardSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">#9FB6C2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
    <string name="salve_chat_expand">Ampliar conversación a pantalla completa</string>
    <string name="salve_chat_shrink">Volver al chat compacto</string>
    <string name="salve_chat_minimize">Minimizar conversación y volver a Salve</string>
    <string name="salve_chat_drag_hint">Desliza para expandir · Toca para pantalla completa</string>
    <string name="salve_chat_full_hint">Desliza hacia abajo para reducir</string>
    <string name="salve_chip_capabilities">¿Qué puedes hacer?</string>
    <string name="salve_chip_bed">Muéstrame tu cama</string>
    <string name="salve_chip_help">Ayúdame con algo</string>
    <string name="salve_stage_subtitle">Aquí contigo</string>
    <string name="salve_stage_hint">Doble toque para conversar
Mantén pulsado para ver las opciones</string>
    <string name="salve_stage_caption">Toca dos veces a Salve para empezar</string>
    <string name="salve_options">Opciones de Salve</string>
    <string name="salve_close_chat">Cerrar conversación</string>
    <string name="salve_close_options">Cerrar opciones</string>
    <string name="salve_chat_title">Conversar</string>
    <string name="salve_chat_empty">Estoy aquí. Puedes escribirme o hablar conmigo.

Prueba «cama» para mostrarla o «guarda la cama» para despejar la pantalla.</string>
    <string name="salve_chat_hint">Escribe a Salve…</string>
    <string name="salve_attach">Documentos</string>
    <string name="salve_voice">Conversar por voz</string>
    <string name="salve_voice_subtitle">Habla con Salve</string>
    <string name="salve_attach_subtitle">Sube y analiza archivos</string>
    <string name="salve_send">Enviar</string>
    <string name="salve_bed_hint">Pídeme «cama», «acuéstate» o «guarda la cama».</string>
</resources>
