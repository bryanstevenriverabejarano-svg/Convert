<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/salve_stage_background" android:fitsSystemWindows="true">

    <LinearLayout android:id="@+id/salveStage" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SALVE" android:letterSpacing="0.22" android:textStyle="bold" android:textSize="18sp" android:textColor="#EAF4F2" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/salve_stage_subtitle" android:textSize="12sp" android:textColor="#ADC5C6" />
            </LinearLayout>
            <Button android:id="@+id/btnStageOptions" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="56dp" android:layout_height="56dp" android:minWidth="48dp"
                android:text="···" android:textSize="24sp" android:textColor="#EAF4F2" android:padding="0dp"
                android:contentDescription="@string/salve_options" />
        </LinearLayout>
        <salve.avatar.AvatarView android:id="@+id/imagenSalve" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/salve" />
        <TextView android:id="@+id/salveCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:text="@string/salve_stage_caption" android:textSize="15sp" android:textColor="#EAF4F2"
            android:maxLines="2" android:ellipsize="end" android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/salve_stage_hint" android:gravity="center" android:textColor="#A9BFC3"
            android:textSize="12sp" android:lineSpacingExtra="3dp" android:paddingBottom="18dp" android:paddingHorizontal="16dp" />
    </LinearLayout>

    <View android:id="@+id/stageScrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#99050910" android:visibility="gone" android:clickable="true" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/chatSheet" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp"
        android:background="@drawable/salve_sheet_background" android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true" app:behavior_skipCollapsed="true" app:behavior_peekHeight="0dp">
        <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
            android:background="#6C8793" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/salve_chat_title" android:textSize="22sp" android:textColor="#EAF4F2" android:paddingStart="8dp" />
            <Button android:id="@+id/btnCloseChat" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="56dp" android:layout_height="56dp" android:minWidth="48dp"
                android:text="×" android:textSize="26sp" android:textColor="#D4E7E7" android:padding="0dp"
                android:contentDescription="@string/salve_close_chat" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:id="@+id/chatScroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <TextView android:id="@+id/chatTranscript" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/salve_chat_empty" android:textColor="#DDE9EA" android:textSize="16sp"
                android:lineSpacingExtra="6dp" android:padding="12dp" android:textIsSelectable="true" />
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:id="@+id/photoContextPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp" android:visibility="gone">
            <ImageView android:id="@+id/photoContextPreview" android:layout_width="56dp" android:layout_height="56dp"
                android:scaleType="centerCrop" android:contentDescription="Ver foto e identificar persona" />
            <TextView android:id="@+id/photoContextLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:padding="8dp" android:maxLines="2" android:ellipsize="end"
                android:textColor="#FFFFFF" android:textSize="12sp" />
            <Button android:id="@+id/btnRemovePhotoContext" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="Quitar"
                android:contentDescription="Quitar foto del chat y conservar el recuerdo" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <EditText android:id="@+id/inputChat" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="52dp" android:maxLines="3"
                android:hint="@string/salve_chat_hint" android:textColor="#F3F7F7" android:textColorHint="#A9BFC3"
                android:background="@drawable/salve_input_background" android:padding="14dp"
                android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend|flagNoExtractUi" android:importantForAutofill="no" />
            <Button android:id="@+id/btnEnviarMensaje" style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="8dp"
                android:minWidth="64dp" android:paddingHorizontal="12dp" android:text="@string/salve_send" />
        </LinearLayout>
        <LinearLayout android:id="@+id/chatActions" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnHablar" style="@style/SalveStageAction" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:text="@string/salve_voice" />
            <Button android:id="@+id/btnAdjuntar" style="@style/SalveStageAction" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:text="@string/salve_attach" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/optionsSheet" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp"
        android:background="@drawable/salve_sheet_background" android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true" app:behavior_skipCollapsed="true" app:behavior_peekHeight="0dp">
        <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
            android:background="#6C8793" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/salve_options" android:textColor="#EAF4F2" android:textSize="22sp" android:paddingStart="8dp" />
            <Button android:id="@+id/btnCloseOptions" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="56dp" android:layout_height="56dp" android:minWidth="48dp" android:text="×" android:textSize="26sp"
                android:textColor="#D4E7E7" android:padding="0dp" android:contentDescription="@string/salve_close_options" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:id="@+id/btnMenuChat" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Escribir a Salve" />
                <Button android:id="@+id/btnMenuVoice" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/salve_voice" />
                <Button android:id="@+id/btnEscuchar" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dictar un mensaje" />
                <Button android:id="@+id/btnAvatar" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vestuario y habitación" />
                <Button android:id="@+id/btnDispositivos" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mi móvil y dispositivos" />
                <Button android:id="@+id/btnMostrarReflexion" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reflexiones" />
                <Button android:id="@+id/btnReflexiones" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recuerdos y galería" />
                <Button android:id="@+id/btnConfigurarIA" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ajustes de IA y cámara" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/salve_bed_hint"
                    android:padding="20dp" android:textColor="#ADC5C6" android:textSize="14sp" />
                <TextView android:id="@+id/tvNivelConciencia" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp" android:paddingBottom="20dp" android:textColor="#8EB7B5" android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/panelReflexion" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="80dp" android:layout_gravity="bottom" android:orientation="vertical" android:padding="20dp"
        android:background="@drawable/salve_sheet_background" android:elevation="10dp" android:visibility="gone">
        <TextView android:id="@+id/tituloReflexion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/titulo_reflexion" android:textColor="#ACDDD3" android:textSize="22sp" android:paddingBottom="16dp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/textoReflexion" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#EAF4F2" android:textSize="16sp" android:lineSpacingExtra="6dp" android:textIsSelectable="true" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnCerrarReflexion" style="@style/SalveStageAction" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:gravity="center" android:text="@string/cerrar" />
            <Button android:id="@+id/btnResponderReflexion" style="@style/SalveStageAction" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:gravity="center" android:text="@string/responder" />
            <Button android:id="@+id/btnSiguienteReflexion" style="@style/SalveStageAction" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:gravity="center" android:text="@string/siguiente" />
        </LinearLayout>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/downloadOverlayContainer"
        android:name="salve.presentation.ui.DownloadOverlayFragment" android:layout_width="match_parent" android:layout_height="match_parent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
