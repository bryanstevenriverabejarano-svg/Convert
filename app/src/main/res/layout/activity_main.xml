<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/salve_stage_background" android:fitsSystemWindows="true">

    <LinearLayout android:id="@+id/salveStage" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SALVE" android:letterSpacing="0.22" android:textStyle="bold" android:textSize="18sp" android:textColor="#EAF4F2" />
                <TextView android:id="@+id/activeModelStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end"
                    android:text="Modelo: preparando" android:textSize="12sp" android:textColor="#ADC5C6" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnStageOptions" android:layout_width="52dp" android:layout_height="52dp"
                android:src="@drawable/ic_salve_more" app:tint="#EAF4F2" android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/salve_options" />
        </LinearLayout>
        <FrameLayout android:id="@+id/avatarFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <!-- Halo azul detrás de Salve; el controlador lo centra en su pecho según el tamaño de pantalla. -->
            <View android:id="@+id/salveHalo" android:layout_width="340dp" android:layout_height="340dp"
                android:layout_gravity="center_horizontal" android:background="@drawable/salve_stage_halo"
                android:importantForAccessibility="no" />
            <salve.avatar.AvatarView android:id="@+id/imagenSalve" android:layout_width="match_parent"
                android:layout_height="match_parent" android:contentDescription="@string/salve" />
            <!-- Espacio astral: lo que Salve dibuja aparece delante de ella; no recibe toques. -->
            <salve.sketch.SketchStageView android:id="@+id/salveSketchStage" android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        <TextView android:id="@+id/salveCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:text="@string/salve_stage_caption" android:textSize="15sp" android:textColor="#EAF4F2"
            android:maxLines="2" android:ellipsize="end" android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground" />
        <LinearLayout android:id="@+id/voiceStageControls" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="8dp" android:visibility="gone">
            <TextView android:id="@+id/voiceStageStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"
                android:textColor="#ACDDD3" android:textSize="14sp" android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btnVoiceInterrupt" style="@style/SalveStageAction" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center"
                    android:text="Interrumpir" android:contentDescription="Interrumpir a Salve y hablar" />
                <Button android:id="@+id/btnVoiceEnd" style="@style/SalveStageAction" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center"
                    android:text="Terminar" android:contentDescription="Terminar la conversación de voz y cerrar el micrófono" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/salveGestureHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/salve_stage_hint" android:gravity="center" android:textColor="#A9BFC3"
            android:textSize="12sp" android:lineSpacingExtra="3dp" android:paddingBottom="18dp" android:paddingHorizontal="16dp" />
    </LinearLayout>

    <View android:id="@+id/stageScrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#99050910" android:visibility="gone" android:clickable="true" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/chatSheet" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp"
        android:background="@drawable/salve_sheet_background" android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true" app:behavior_skipCollapsed="false" app:behavior_peekHeight="250dp"
        app:behavior_fitToContents="false">
        <!-- Zona de agarre: el gesto vertical permite pasar de media pantalla a pantalla completa. -->
        <FrameLayout android:id="@+id/chatDragHandle" android:layout_width="match_parent"
            android:layout_height="30dp" android:contentDescription="@string/salve_chat_drag_hint"
            android:clickable="true" android:focusable="true">
            <View android:layout_width="48dp" android:layout_height="5dp" android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp" android:background="@drawable/salve_drag_handle"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <!-- En pantalla completa conserva el rostro de Salve, enlazado a los estados reales del motor. -->
            <FrameLayout android:id="@+id/chatPresenceBadge" android:layout_width="46dp"
                android:layout_height="46dp" android:layout_marginEnd="6dp" android:visibility="gone"
                android:importantForAccessibility="no">
                <View android:id="@+id/chatPresenceHalo" android:layout_width="46dp"
                    android:layout_height="46dp" android:layout_gravity="center"
                    android:background="@drawable/salve_presence_halo" android:alpha="0.35"
                    android:importantForAccessibility="no" />
                <ImageView android:id="@+id/chatPresenceAvatar" android:layout_width="40dp"
                    android:layout_height="40dp" android:layout_gravity="center"
                    android:src="@drawable/salve_chat_avatar"
                    android:contentDescription="@string/salve_presence_idle" />
            </FrameLayout>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/salve_chat_title" android:textStyle="bold" android:textSize="26sp" android:textColor="#F2F8FA" android:paddingStart="8dp" />
            <ImageButton android:id="@+id/btnExpandChat" android:layout_width="50dp" android:layout_height="50dp"
                android:src="@drawable/ic_salve_expand" app:tint="#DCEAF0" android:scaleType="center"
                android:background="@drawable/salve_circle_button" android:layout_marginEnd="12dp"
                android:contentDescription="@string/salve_chat_expand" />
            <ImageButton android:id="@+id/btnCloseChat" android:layout_width="50dp" android:layout_height="50dp"
                android:src="@drawable/ic_salve_chevron_down" app:tint="#DCEAF0" android:scaleType="center"
                android:background="@drawable/salve_circle_button" android:layout_marginEnd="4dp"
                android:contentDescription="@string/salve_chat_minimize" />
        </LinearLayout>
        <TextView android:id="@+id/chatModelStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Modelo: preparando" android:textColor="#A9BCC8" android:textSize="13sp" android:paddingHorizontal="8dp"
            android:paddingBottom="8dp" android:maxLines="1" android:ellipsize="end" />
        <androidx.core.widget.NestedScrollView android:id="@+id/chatScroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/voiceDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#ACDDD3" android:textSize="14sp" android:padding="12dp" android:visibility="gone"
                android:textIsSelectable="true" />
            <!-- Conversación: bloques de texto y, entre ellos, los lienzos de los dibujos de Salve. -->
            <LinearLayout android:id="@+id/chatThread" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/chatTranscript" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/salve_chat_empty" android:textColor="#DDE9EA" android:textSize="16sp"
                android:lineSpacingExtra="5dp" android:layout_margin="6dp" android:background="@drawable/salve_chat_bubble_salve"
                android:padding="14dp" android:textIsSelectable="true" />
            </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:id="@+id/photoContextPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp" android:visibility="gone">
            <ImageView android:id="@+id/photoContextPreview" android:layout_width="56dp" android:layout_height="56dp"
                android:scaleType="centerCrop" android:contentDescription="Ver foto e identificar persona" />
            <TextView android:id="@+id/photoContextLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:padding="8dp" android:maxLines="2" android:ellipsize="end"
                android:textColor="#FFFFFF" android:textSize="12sp" />
            <Button android:id="@+id/btnRemovePhotoContext" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="Quitar"
                android:contentDescription="Quitar foto del chat y conservar el recuerdo" />
        </LinearLayout>
        <!-- Mientras Salve piensa: tres puntos de luz y lo que está haciendo ahora mismo. -->
        <LinearLayout android:id="@+id/thinkingRow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp"
            android:paddingVertical="6dp" android:visibility="gone" android:accessibilityLiveRegion="polite">
            <salve.presentation.ui.ThinkingDotsView android:id="@+id/thinkingDots"
                android:layout_width="44dp" android:layout_height="22dp" />
            <TextView android:id="@+id/thinkingLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Pensando…"
                android:textColor="#7FDFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <!-- Sugerencias opcionales: rellenan el borrador, nunca envían sin confirmación. -->
        <HorizontalScrollView android:id="@+id/chatSuggestions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fillViewport="false"
            android:scrollbars="none" android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="20dp" android:paddingTop="4dp" android:paddingBottom="6dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/chipCapabilities" style="@style/SalveChatChip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/salve_chip_capabilities" />
                <com.google.android.material.button.MaterialButton android:id="@+id/chipBed" style="@style/SalveChatChip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/salve_chip_bed" />
                <com.google.android.material.button.MaterialButton android:id="@+id/chipHelp" style="@style/SalveChatChip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/salve_chip_help" />
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:paddingTop="4dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="58dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:background="@drawable/salve_input_background" android:paddingStart="6dp" android:paddingEnd="6dp">
                <ImageButton android:id="@+id/btnAttachInline" android:layout_width="44dp" android:layout_height="44dp"
                    android:src="@drawable/ic_salve_attach" app:tint="#C9DCE4" android:scaleType="center"
                    android:background="@drawable/salve_attach_background" android:rotation="45"
                    android:contentDescription="Adjuntar documento o foto" />
                <EditText android:id="@+id/inputChat" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="52dp" android:maxLines="3"
                    android:hint="@string/salve_chat_hint" android:textColor="#F3F7F7" android:textColorHint="#A9BFC3"
                    android:textSize="17sp" android:background="@android:color/transparent"
                    android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend|flagNoExtractUi" android:importantForAutofill="no" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEnviarMensaje"
                style="@style/SalveSendButton" android:layout_width="58dp" android:layout_height="58dp"
                android:layout_marginStart="10dp" android:contentDescription="@string/salve_send" />
        </LinearLayout>
        <!-- Una sola acción de voz; los documentos y las fotos permanecen en el clip del compositor. -->
        <LinearLayout android:id="@+id/chatActions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="12dp">
            <LinearLayout android:id="@+id/btnHablar" style="@style/SalveActionCard"
                android:contentDescription="@string/salve_voice_action">
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/salve_icon_circle" android:importantForAccessibility="no">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp"
                        android:layout_gravity="center" android:src="@drawable/ic_salve_mic"
                        app:tint="#7FE3D2" android:importantForAccessibility="no" />
                </FrameLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginStart="14dp" android:src="@drawable/ic_salve_waveform"
                    app:tint="#7FE3D2" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="16dp"
                    android:orientation="vertical" android:importantForAccessibility="no">
                    <TextView style="@style/SalveActionCardTitle"
                        android:text="@string/salve_voice_action" />
                    <TextView style="@style/SalveActionCardSubtitle"
                        android:text="@string/salve_voice_full_subtitle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/chatResizeHint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/salve_chat_drag_hint"
            android:textSize="13sp" android:textColor="#9BB4C5" android:gravity="center"
            android:paddingTop="12dp" android:paddingBottom="4dp"
            android:drawableStart="@drawable/ic_salve_chevron_up" android:drawableTint="#9BB4C5" android:drawablePadding="6dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout android:id="@+id/optionsSheet" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp"
        android:background="@drawable/salve_sheet_background" android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true" app:behavior_skipCollapsed="true" app:behavior_peekHeight="0dp">
        <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
            android:background="#6C8793" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/salve_options" android:textColor="#EAF4F2" android:textSize="22sp" android:paddingStart="8dp" />
            <Button android:id="@+id/btnCloseOptions" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="56dp" android:layout_height="56dp" android:minWidth="48dp" android:text="×" android:textSize="26sp"
                android:textColor="#D4E7E7" android:padding="0dp" android:contentDescription="@string/salve_close_options" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:id="@+id/btnMenuChat" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Escribir a Salve" />
                <Button android:id="@+id/btnMenuVoice" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/salve_voice" />
                <Button android:id="@+id/btnEscuchar" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dictar un mensaje" />
                <Button android:id="@+id/btnAvatar" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vestuario y habitación" />
                <Button android:id="@+id/btnTeachDrawing" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enséñale a dibujar" />
                <Button android:id="@+id/btnDispositivos" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mi móvil y dispositivos" />
                <Button android:id="@+id/btnMostrarReflexion" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reflexiones" />
                <Button android:id="@+id/btnReflexiones" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recuerdos y galería" />
                <Button android:id="@+id/btnConfigurarIA" style="@style/SalveStageAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ajustes de IA y cámara" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/salve_bed_hint"
                    android:padding="20dp" android:textColor="#ADC5C6" android:textSize="14sp" />
                <TextView android:id="@+id/tvNivelConciencia" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp" android:paddingBottom="20dp" android:textColor="#8EB7B5" android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/panelReflexion" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="80dp" android:layout_gravity="bottom" android:orientation="vertical" android:padding="20dp"
        android:background="@drawable/salve_sheet_background" android:elevation="10dp" android:visibility="gone">
        <TextView android:id="@+id/tituloReflexion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/titulo_reflexion" android:textColor="#ACDDD3" android:textSize="22sp" android:paddingBottom="16dp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/textoReflexion" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#EAF4F2" android:textSize="16sp" android:lineSpacingExtra="6dp" android:textIsSelectable="true" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnCerrarReflexion" style="@style/SalveStageAction" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:gravity="center" android:text="@string/cerrar" />
            <Button android:id="@+id/btnResponderReflexion" style="@style/SalveStageAction" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:gravity="center" android:text="@string/responder" />
            <Button android:id="@+id/btnSiguienteReflexion" style="@style/SalveStageAction" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:gravity="center" android:text="@string/siguiente" />
        </LinearLayout>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/downloadOverlayContainer"
        android:name="salve.presentation.ui.DownloadOverlayFragment" android:layout_width="match_parent" android:layout_height="match_parent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
