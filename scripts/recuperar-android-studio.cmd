@echo off
echo Recuperacion para la captura: Android Studio1, proceso 5432.
echo Conserva los proyectos, ajustes y modelos de Salve.
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $studioExe='C:\Program Files\Android\Android Studio1\bin\studio64.exe'; if (!(Test-Path -LiteralPath $studioExe -PathType Leaf)) { throw 'No se encuentra la instalacion de la captura. Revisa su ruta; no se ha cerrado ningun proceso.' }; $studioProcess=Get-Process -Id 5432 -ErrorAction SilentlyContinue; if ($null -ne $studioProcess) { if ($studioProcess.ProcessName -ine 'studio64' -or $studioProcess.Path -ine $studioExe) { throw 'El PID 5432 pertenece ahora a otro proceso o instalacion. No se ha cerrado.' }; Write-Warning 'Se intentara cerrar Android Studio. El cierre forzado puede perder cambios sin guardar.'; [void]$studioProcess.CloseMainWindow(); if (!$studioProcess.WaitForExit(10000)) { if ($studioProcess.Responding) { throw 'Android Studio responde. Revisa su ventana y guarda o cierra los cambios pendientes.' }; Stop-Process -InputObject $studioProcess -Force -ErrorAction Stop; if (!$studioProcess.WaitForExit(5000)) { throw 'El proceso sigue activo; no se abrira otra instancia.' } } }; $remaining=@(Get-Process -Name studio64 -ErrorAction SilentlyContinue | Where-Object { $_.Path -ieq $studioExe }); if ($remaining.Count -gt 0) { Write-Host 'Ya hay una instancia abierta en esa instalacion. Vuelve a su ventana; no se ha abierto otra.' } else { Start-Process -FilePath $studioExe -ErrorAction Stop; Write-Host 'Se ha solicitado abrir Android Studio. Comprueba su ventana.' }"
set "SALVE_RECOVERY_RESULT=%ERRORLEVEL%"
echo.
pause
exit /b %SALVE_RECOVERY_RESULT%
